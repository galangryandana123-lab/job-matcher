generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Required for Supabase with pgbouncer
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  jobMatches    JobMatch[]
  savedJobs     SavedJob[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  fullName          String
  email             String
  phone             String?
  location          String?
  linkedinUrl       String?
  portfolioUrl      String?
  currentPosition   String?
  yearsOfExperience Int      @default(0)
  summary           String?  @db.Text
  rawCvUrl          String?
  parsedData        Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          Skill[]
  workExperiences WorkExperience[]
  educations      Education[]
  certifications  Certification[]
}

model Skill {
  id               String  @id @default(cuid())
  profileId        String
  name             String
  category         String  @default("technical") // technical, soft, language
  proficiencyLevel String? // beginner, intermediate, advanced, expert
  yearsOfExperience Int?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([name])
}

model WorkExperience {
  id          String    @id @default(cuid())
  profileId   String
  jobTitle    String
  companyName String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?   @db.Text
  industry    String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Education {
  id             String @id @default(cuid())
  profileId      String
  degree         String
  institution    String
  fieldOfStudy   String
  graduationYear Int?
  gpa            Float?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Certification {
  id                  String    @id @default(cuid())
  profileId           String
  name                String
  issuingOrganization String
  issueDate           DateTime?
  expiryDate          DateTime?
  credentialUrl       String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Job {
  id                   String    @id @default(cuid())
  title                String
  companyName          String
  companyLogo          String?
  location             String
  workType             String    @default("full-time") // full-time, part-time, contract, internship, freelance
  workMode             String    @default("on-site") // remote, hybrid, on-site
  salaryMin            Float?
  salaryMax            Float?
  salaryCurrency       String    @default("IDR")
  description          String    @db.Text
  requirements         String?   @db.Text
  requiredSkills       String[]
  experienceLevel      String    @default("mid") // entry, mid, senior, lead, executive
  educationRequirement String?
  industry             String?
  companySize          String?
  benefits             String[]
  postedDate           DateTime  @default(now())
  applicationDeadline  DateTime?
  sourceUrl            String
  sourcePortal         String
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  jobMatches JobMatch[]
  savedJobs  SavedJob[]

  @@index([title])
  @@index([location])
  @@index([workType])
  @@index([experienceLevel])
  @@index([isActive])
  @@index([postedDate])
}

model JobMatch {
  id              String   @id @default(cuid())
  userId          String
  jobId           String
  overallScore    Float
  skillScore      Float
  experienceScore Float
  educationScore  Float
  locationScore   Float
  seniorityScore  Float
  industryScore   Float
  matchingSkills  String[]
  missingSkills   String[]
  matchDetails    Json?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([overallScore])
}

model SavedJob {
  id      String   @id @default(cuid())
  userId  String
  jobId   String
  savedAt DateTime @default(now())
  notes   String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}
